---
import { getCollection } from 'astro:content';

const pages = (await getCollection('docs'))
	.filter((page) => page.id !== 'index')
	.sort((a, b) => a.id.localeCompare(b.id));

const categories = [
	{
		key: 'guides',
		title: '数据技术整理',
		intro: '从传感器采集到训练交付，关注真实设备上的数据质量。',
	},
	{
		key: 'simulation',
		title: '仿真器',
		intro: '按发展路径和技术链路阅读仿真数据的生产、质量控制与真实验证。',
	},
	{
		key: 'reference',
		title: '参考资料',
		intro: '统一术语、格式和常用概念，便于跨主题阅读。',
	},
];

type Page = typeof pages[number];
const getCategory = (page: Page) => {
	const section = page.id.split('/')[0];
	return section === 'reference' || section === 'simulation' ? section : 'guides';
};
const getHref = (page: Page) => `/${page.id.replace(/\/index$/, '')}/`;
const simulationOrder = new Map([
	'simulation',
	'simulation/simulation-history-design',
	'simulation/simulators-embodied-data',
	'simulation/simulation-scene-physics',
	'simulation/simulation-sensors-timing',
	'simulation/simulation-task-generation',
	'simulation/simulation-validation-sim2real',
	'simulation/mujoco-embodied-data',
	'simulation/isaac-lab-embodied-data',
].map((id, index) => [id, index]));
const getCategoryPages = (key: string) => {
	const categoryPages = pages.filter((page) => getCategory(page) === key);
	if (key === 'simulation') {
		categoryPages.sort((a, b) => (simulationOrder.get(a.id) ?? 99) - (simulationOrder.get(b.id) ?? 99));
	}
	return categoryPages;
};
---

<div class="home-intro" id="文档目录">
	<div>
		<p class="home-kicker">DOCUMENTATION INDEX</p>
		<h2>按项目查找</h2>
		<p>从真实数据与仿真数据两个项目进入，再按任务查找采集、生成、对齐、质量控制和评估资料。</p>
	</div>
	<div class="home-stats" aria-label="文档统计">
		<strong>{pages.length}</strong>
		<span>篇文档</span>
	</div>
</div>

<div class="home-project-grid" aria-label="项目入口">
	{categories.filter((category) => category.key !== 'reference').map((category, index) => (
		<a class="home-project" href={category.key === 'simulation' ? '/simulation/' : '#category-guides'}>
			<span class="home-project-index">项目 {String(index + 1).padStart(2, '0')}</span>
			<h3>{category.title}</h3>
			<p>{category.intro}</p>
			<span class="home-project-action">进入项目 ↗</span>
		</a>
	))}
</div>

<div class="home-categories">
	{categories.map((category) => {
		const categoryPages = getCategoryPages(category.key);
		return (
			<section class="home-section" aria-labelledby={`category-${category.key}`}>
				<div class="home-section-heading">
					<div>
						<p class="home-section-index">{String(categories.indexOf(category) + 1).padStart(2, '0')}</p>
						<h2 id={`category-${category.key}`}>{category.title}</h2>
					</div>
					<p>{category.intro}</p>
				</div>
				<div class="home-doc-grid">
					{categoryPages.map((page) => (
						<a class="home-doc" href={getHref(page)}>
							<span class="home-doc-arrow" aria-hidden="true">↗</span>
							<h3>{page.data.title}</h3>
							<p>{page.data.description}</p>
						</a>
					))}
				</div>
			</section>
		);
	})}
</div>
